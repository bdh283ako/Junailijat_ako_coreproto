{
  "name": "junailijat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "local:dev": "docker compose up --wait --wait-timeout 60 -d postgres && pnpm dev",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "dotenv -e .env.local -- cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "db:migrate:create": "dotenv -e .env.local -- cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "data:import-legacy": "dotenv -e .env.local -- tsx scripts/import-legacy-demo-store.ts",
    "format": "oxfmt",
    "generate:importmap": "dotenv -e .env.local -- cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "dotenv -e .env.local -- cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "dotenv -e .env.local -- cross-env NODE_OPTIONS=--no-deprecation payload"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "4.0.0-beta.8",
    "@payloadcms/next": "4.0.0-beta.8",
    "@payloadcms/plugin-mcp": "4.0.0-beta.8",
    "@payloadcms/richtext-lexical": "4.0.0-beta.8",
    "@payloadcms/translations": "4.0.0-beta.8",
    "@payloadcms/ui": "4.0.0-beta.8",
    "graphql": "^16.8.1",
    "leaflet": "^1.9.4",
    "monaco-editor": "0.55.1",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "payload": "4.0.0-beta.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-leaflet": "^5.0.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "24.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "10.1.0",
    "dotenv": "^16.6.1",
    "dotenv-cli": "^10.0.0",
    "oxfmt": "^0.73.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.6",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": "^9 || ^10 || ^11"
  },
  "packageManager": "pnpm@10.34.9",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
